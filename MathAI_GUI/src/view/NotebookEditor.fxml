<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane fx:id="notebookEditor" prefHeight="600.0" prefWidth="800.0"
            styleClass="root"
            stylesheets="@../styles/Main.css"
            xmlns="http://javafx.com/javafx/24.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.Notebookeditor.NotebookEditorController" style="-fx-background-color: #18181889">

    <children>
        <BorderPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

            <!-- 🔹 Left Sidebar -->
            <left>
                <VBox fx:id="toolSidebar" prefWidth="160.0" spacing="10" styleClass="sidebar">
                    <padding>
                        <Insets bottom="15" left="10" right="10" top="15" />
                    </padding>

                    <Label styleClass="section-subtitle" text="✏ Tools" />
                    <Button fx:id="penButton" styleClass="sidebar-button" text="🖊 Pen" />
                    <Button fx:id="eraserButton" styleClass="sidebar-button" text="🩹 Eraser" />
                    <Button fx:id="selectButton" styleClass="sidebar-button" text="🔲 Select" />
                    <Button fx:id="predictButton" styleClass="sidebar-button" text="🤖 Predict" />
                    <Button fx:id="clearButton" styleClass="sidebar-button" text="🧹 Clear" />

                    <!-- 🔹 Pen & Eraser Size Controls -->
                    <Label styleClass="section-subtitle" text="✏ Pen Size" />
                    <Slider fx:id="penSizeSlider" styleClass="size-slider" blockIncrement="1" max="20" min="1" value="3" />

                    <Label styleClass="section-subtitle" text="🩹 Eraser Size" />
                    <Slider fx:id="eraserSizeSlider" styleClass="size-slider" blockIncrement="5" max="50" min="5" value="15" />

                    <VBox prefHeight="30" />

                    <Label styleClass="section-subtitle" text="AI" />
                    <Button fx:id="aiPredictButton" styleClass="sidebar-button" text="✨ AI Prediction" />
                </VBox>
            </left>

            <!-- 🔹 Main Editor Area -->
            <center>
                <SplitPane fx:id="mainSplitPane" dividerPositions="0.8" styleClass="split-pane" >
                    <items>
                        <!-- Pages Area -->
                        <AnchorPane styleClass="editor-area">
                            <ScrollPane fx:id="scrollpane" fitToHeight="true" fitToWidth="true" styleClass="document-scroll-pane"
                                        AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0" style="-fx-background-color: #18181889">
                                <content>
                                    <VBox fx:id="pagesContainer" alignment="TOP_CENTER" spacing="10" styleClass="pages-container">
                                        <padding>
                                            <Insets bottom="15" left="15" right="15" top="15" />
                                        </padding>
                                    </VBox>
                                </content>
                            </ScrollPane>
                        </AnchorPane>

                        <!-- Right AI Panel -->
                        <BorderPane fx:id="rightPanel" prefWidth="260" styleClass="right-panel">

                            <!-- 🔹 Top Toolbar -->
                            <top>
                                <ToolBar fx:id="AIPanelTopBar" styleClass="panel-toolbar">
                                    <HBox alignment="CENTER_LEFT" HBox.hgrow="ALWAYS" styleClass="panel-header">
                                        <Label styleClass="section-title" text="🤖 AI Prediction" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Button fx:id="closeButton" styleClass="round-button" text="×" />
                                    </HBox>
                                </ToolBar>
                            </top>

                            <!-- 🔹 Main Content -->
                            <center>
                                <VBox fx:id="AIPanel" spacing="12" styleClass="ai-panel">
                                    <VBox fx:id="questionBox" styleClass="ai-box" />
                                    <VBox fx:id="answerBox" styleClass="ai-box" />
                                </VBox>
                            </center>

                            <!-- 🔹 Bottom Input Field -->
                            <bottom>
                                <HBox spacing="6" BorderPane.alignment="CENTER" styleClass="ai-input-bar">
                                    <TextField fx:id="AIInputField" promptText="Type your question..." HBox.hgrow="ALWAYS" />
                                    <Button fx:id="sendAiButton" styleClass="round-button" text="➤" />
                                </HBox>
                            </bottom>
                        </BorderPane>
                    </items>
                </SplitPane>
            </center>

            <!-- 🔹 Bottom Add Page -->
            <bottom>
                <HBox fx:id="bottomHox" alignment="CENTER" styleClass="bottom-bar">
                    <Button fx:id="addPageButton" styleClass="action-button" text="+ Add New Page" />
                </HBox>
            </bottom>

            <!-- 🔹 Top Toolbar -->
            <top>
                <HBox fx:id="topBar" alignment="CENTER_LEFT" prefHeight="50" spacing="10" styleClass="top-bar">
                    <padding>
                        <Insets left="15" right="15" />
                    </padding>
                    <Button fx:id="goHomeButton" styleClass="round-button" text="🏠 Home"  />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button fx:id="undoButton" styleClass="round-button" text="↩ Undo" />
                    <Button fx:id="redoButton" styleClass="round-button" text="↪ Redo" />
                    <Button fx:id="settingsButton" onAction="#openSettings" styleClass="round-button" text="⚙ Settings" />
                </HBox>
            </top>

        </BorderPane>
    </children>
</AnchorPane>
